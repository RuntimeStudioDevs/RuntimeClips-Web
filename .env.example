# RuntimeClips-Web — Variables de Entorno del Frontend
# Copia este archivo a `.env` o `.env.local` si deseas cambiar las URLs del backend.

# URL base del servidor backend (Express, FastAPI, NestJS, etc.)
VITE_BACKEND_URL=http://localhost:3000

# URL WebSocket para eventos en tiempo real (opcional si usas Server-Sent Events /api/pipeline/events)
VITE_BACKEND_WS_URL=ws://localhost:3000/ws
